generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                 @id @default(cuid())
  name                      String?
  email                     String?                @unique
  emailVerified             DateTime?
  image                     String?
  role                      Role                   @default(CLIENT)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  hashedPassword            String?
  status                    UserStatus             @default(ACTIVE)
  measurementUnit           MeasurementUnit        @default(INCH)
  passwordResetToken        String?
  passwordResetTokenExpires DateTime?
  phone                     String?                @unique
  otpCode                   String?
  otpExpires                DateTime?
  accounts                  Account[]
  sessions                  Session[]
  assignedClients           ClientDesigner[]
  clientGroups              ClientGroup[]
  clientProfile             Client?                @relation("ClientUser")
  financeCategories         FinanceCategory[]
  inventoryStocks           InventoryStock[]
  logs                      Log[]
  shareLinksCreated         MeasurementShareLink[]
  createdMeasurements       Measurement[]
  transactions              Transaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Log {
  id        String   @id @default(cuid())
  userId    String?
  ipAddress String?
  os        String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("logs")
}

model ClientDesigner {
  clientId   String
  designerId String
  assignedAt DateTime @default(now())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  designer   User     @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@id([clientId, designerId])
  @@map("client_designers")
}

model Client {
  id                String                 @id @default(cuid())
  name              String
  phone             String?
  email             String?
  address           String?
  dateOfBirth       DateTime?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  userId            String?                @unique
  status            RecordStatus           @default(ACTIVE)
  assignedDesigners ClientDesigner[]
  groupMembers      ClientGroupMember[]
  user              User?                  @relation("ClientUser", fields: [userId], references: [id])
  jobCostings       JobCosting[]
  shareLinks        MeasurementShareLink[]
  measurements      Measurement[]

  @@index([name])
  @@map("clients")
}

model Measurement {
  id                           String                @id @default(cuid())
  clientId                     String
  creatorId                    String
  shoulderToChestSnug          Float?
  shoulderToChestStatic        Float?
  shoulderToChestDynamic       Float?
  shoulderToBustSnug           Float?
  shoulderToBustStatic         Float?
  shoulderToBustDynamic        Float?
  shoulderToUnderbustSnug      Float?
  shoulderToUnderbustStatic    Float?
  shoulderToUnderbustDynamic   Float?
  shoulderToWaistFrontSnug     Float?
  shoulderToWaistFrontStatic   Float?
  shoulderToWaistFrontDynamic  Float?
  shoulderToWaistBackSnug      Float?
  shoulderToWaistBackStatic    Float?
  shoulderToWaistBackDynamic   Float?
  waistToHipSnug               Float?
  waistToHipStatic             Float?
  waistToHipDynamic            Float?
  shoulderToKneeSnug           Float?
  shoulderToKneeStatic         Float?
  shoulderToKneeDynamic        Float?
  shoulderToDressLengthSnug    Float?
  shoulderToDressLengthStatic  Float?
  shoulderToDressLengthDynamic Float?
  shoulderToAnkleSnug          Float?
  shoulderToAnkleStatic        Float?
  shoulderToAnkleDynamic       Float?
  shoulderWidthSnug            Float?
  shoulderWidthStatic          Float?
  shoulderWidthDynamic         Float?
  nippleToNippleSnug           Float?
  nippleToNippleStatic         Float?
  nippleToNippleDynamic        Float?
  offShoulderSnug              Float?
  offShoulderStatic            Float?
  offShoulderDynamic           Float?
  bustSnug                     Float?
  bustStatic                   Float?
  bustDynamic                  Float?
  underBustSnug                Float?
  underBustStatic              Float?
  underBustDynamic             Float?
  waistSnug                    Float?
  waistStatic                  Float?
  waistDynamic                 Float?
  hipSnug                      Float?
  hipStatic                    Float?
  hipDynamic                   Float?
  thighSnug                    Float?
  thighStatic                  Float?
  thighDynamic                 Float?
  kneeSnug                     Float?
  kneeStatic                   Float?
  kneeDynamic                  Float?
  ankleSnug                    Float?
  ankleStatic                  Float?
  ankleDynamic                 Float?
  neckSnug                     Float?
  neckStatic                   Float?
  neckDynamic                  Float?
  shirtSleeveSnug              Float?
  shirtSleeveStatic            Float?
  shirtSleeveDynamic           Float?
  elbowLengthSnug              Float?
  elbowLengthStatic            Float?
  elbowLengthDynamic           Float?
  longSleevesSnug              Float?
  longSleevesStatic            Float?
  longSleevesDynamic           Float?
  aroundArmSnug                Float?
  aroundArmStatic              Float?
  aroundArmDynamic             Float?
  elbowSnug                    Float?
  elbowStatic                  Float?
  elbowDynamic                 Float?
  wristSnug                    Float?
  wristStatic                  Float?
  wristDynamic                 Float?
  inSeamSnug                   Float?
  inSeamStatic                 Float?
  inSeamDynamic                Float?
  outSeamSnug                  Float?
  outSeamStatic                Float?
  outSeamDynamic               Float?
  notes                        String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  completionDeadline           DateTime?
  designImageUrl               String?
  materialImageUrl             String?
  orderStatus                  OrderStatus           @default(ORDER_CONFIRMED)
  status                       RecordStatus          @default(ACTIVE)
  jobCostings                  JobCosting[]
  shareLink                    MeasurementShareLink?
  client                       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator                      User                  @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@map("measurements")
}

model FinanceCategory {
  id           String              @id @default(cuid())
  name         String
  type         FinanceCategoryType
  usageCount   Int                 @default(0)
  isGlobal     Boolean             @default(false)
  designerId   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  unit         String              @default("unit")
  designer     User?               @relation(fields: [designerId], references: [id])
  stock        InventoryStock?
  transactions Transaction[]

  @@unique([name, designerId, type])
  @@map("finance_categories")
}

model InventoryStock {
  id                String          @id @default(cuid())
  categoryId        String          @unique
  designerId        String
  currentQuantity   Float           @default(0)
  lowStockThreshold Float           @default(0)
  unitPriceAverage  Float           @default(0)
  lastRestocked     DateTime?
  updatedAt         DateTime        @updatedAt
  category          FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  designer          User            @relation(fields: [designerId], references: [id])

  @@map("inventory_stocks")
}

model Transaction {
  id              String          @id @default(cuid())
  type            TransactionType
  categoryId      String
  designerId      String
  amount          Float
  quantity        Float           @default(1)
  date            DateTime        @default(now())
  notes           String?
  receiptImageUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  jobCostings     JobCosting[]
  category        FinanceCategory @relation(fields: [categoryId], references: [id])
  designer        User            @relation(fields: [designerId], references: [id])

  @@map("transactions")
}

model JobCosting {
  id            String       @id @default(cuid())
  transactionId String
  clientId      String
  measurementId String?
  quantityUsed  Float        @default(0)
  createdAt     DateTime     @default(now())
  client        Client       @relation(fields: [clientId], references: [id])
  measurement   Measurement? @relation(fields: [measurementId], references: [id])
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("job_costings")
}

model ClientGroup {
  id         String              @id @default(cuid())
  name       String
  designerId String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  members    ClientGroupMember[]
  designer   User                @relation(fields: [designerId], references: [id])

  @@unique([name, designerId])
  @@map("client_groups")
}

model ClientGroupMember {
  groupId  String
  clientId String
  client   Client      @relation(fields: [clientId], references: [id])
  group    ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, clientId])
  @@map("client_group_members")
}

model MeasurementShareLink {
  id              String       @id @default(cuid())
  token           String       @unique
  expiresAt       DateTime
  updateWindowEnd DateTime?
  clientId        String
  designerId      String
  measurementId   String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  designer        User         @relation(fields: [designerId], references: [id])
  measurement     Measurement? @relation(fields: [measurementId], references: [id])

  @@map("measurement_share_links")
}

enum Role {
  CLIENT
  DESIGNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DELETED
}

enum MeasurementUnit {
  INCH
  CENTIMETER
}

enum RecordStatus {
  ACTIVE
  DELETED
}

enum OrderStatus {
  ORDER_CONFIRMED
  IN_PROGRESS
  COMPLETED
  DELIVERED
}

enum FinanceCategoryType {
  MATERIAL
  TOOL
  BILL
  REVENUE
  LABOUR
  MARKETING
  RENT
  OTHER
}

enum TransactionType {
  REVENUE
  EXPENSE
  USAGE
}
